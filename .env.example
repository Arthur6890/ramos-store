DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/ramos-store
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Only needed in production (Vercel). Leave unset for local dev — media
# uploads fall back to local disk. See docs/adr/0002.
BLOB_READ_WRITE_TOKEN=

# Seller's WhatsApp number in E.164 digits only, no "+" (ex: 5531999999999).
# Used to build the pre-filled "Complete Order" link. See ADR-0001.
NEXT_PUBLIC_SELLER_WHATSAPP_NUMBER=5531996103374

# Store's Instagram profile URL, shown in the footer.
NEXT_PUBLIC_INSTAGRAM_URL=
